      "refersTo": "event-record",
      "description": "Inspectable record with a chronology node. Sample values are illustrative; disclosure matches the implemented native structure.",
      "html": "<div class=\"ds-event\"><div class=\"ds-event-rail\"><i></i></div><details class=\"ds-event-card\"><summary><span class=\"ds-event-meta\"><span>now</span><strong>Latest</strong></span><span class=\"ds-event-title\">Chain event received</span><span class=\"ds-event-body\">A new observation is available.</span><span class=\"ds-event-show\">View event data <svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"m4 6 4 4 4-4\"/></svg></span><span class=\"ds-event-hide\">Hide event data <svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"m4 10 4-4 4 4\"/></svg></span></summary><div class=\"ds-event-data\"><span>event_id</span><code>example-event-01</code><span>network</span><code>example-network</code></div></details></div>",
      "css": ".ds-event{display:flex;gap:10px;font-family:system-ui;background:#F3F2FA}.ds-event-rail{width:24px;flex-shrink:0;display:flex;justify-content:center}.ds-event-rail i{display:block;width:7px;height:7px;margin-top:22px;border:2px solid #826000;border-radius:6px;background:#826000}.ds-event-card{flex:1;min-width:0;background:#fff;border-radius:16px;overflow:hidden;color:#252137}.ds-event-card summary{display:flex;flex-direction:column;gap:8px;padding:16px;list-style:none;cursor:pointer}.ds-event-card summary::-webkit-details-marker{display:none}.ds-event-card summary:hover,.ds-event-card summary:active{opacity:.72}.ds-event-card summary:focus-visible{outline:2px solid #6442C5;outline-offset:-3px}.ds-event-meta{display:flex;justify-content:space-between;gap:8px;font-size:12px;line-height:17px;color:#686178}.ds-event-meta strong{font-weight:600;color:#826000}.ds-event-title{font-size:18px;font-weight:700;letter-spacing:-.3px}.ds-event-body{font-size:17px;line-height:25px;color:#686178}.ds-event-show,.ds-event-hide{margin-top:4px;color:#6442C5;font-size:13px;line-height:19px;font-weight:600}.ds-event-hide{display:none}.ds-event-card[open] .ds-event-show{display:none}.ds-event-card[open] .ds-event-hide{display:block}.ds-event-data{display:grid;gap:4px;padding:0 16px 16px;animation:ds-event-reveal 180ms}.ds-event-data span{font-size:12px;line-height:17px;color:#686178}.ds-event-data code{font:13px Menlo,monospace;overflow-wrap:anywhere;margin-bottom:8px}@keyframes ds-event-reveal{from{opacity:.4}to{opacity:1}}@media(prefers-reduced-motion:reduce){.ds-event-data{animation:none}}@media(prefers-color-scheme:dark){.ds-event{background:#191623}.ds-event-card{background:#302A40;color:#F1EDF9}.ds-event-meta,.ds-event-body,.ds-event-data span{color:#B7AEC8}.ds-event-meta strong{color:#E8C66A}.ds-event-rail i{background:#E8C66A;border-color:#E8C66A}.ds-event-show,.ds-event-hide{color:#C4ACFF}}.ds-event-show svg,.ds-event-hide svg{vertical-align:middle}"
    },
    {
      "name": "Settings Group",
      "kind": "card",
      "refersTo": "settings-group",
      "description": "Grouped native information rows with an inset divider and full-size Copy control. Copy is a visual sample.",
      "html": "<div class=\"ds-settings\"><div class=\"ds-settings-row\"><span>Notifications</span><span class=\"ds-settings-muted\">Allowed</span></div><div class=\"ds-settings-rule\"></div><div class=\"ds-settings-token\"><span>Push token</span><div><code>example123…456abc</code><button>Copy</button></div></div></div>",
      "css": ".ds-settings{background:#fff;border-radius:16px;color:#252137;font:17px/25px system-ui;overflow:hidden}.ds-settings-row{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px;padding:18px}.ds-settings-muted{color:#686178}.ds-settings-rule{height:1px;margin-left:18px;background:#DCD8EB}.ds-settings-token{padding:18px;display:flex;flex-direction:column;gap:8px}.ds-settings-token>div{display:flex;gap:8px;align-items:center}.ds-settings-token code{flex:1;font:13px Menlo,monospace;color:#686178;overflow-wrap:anywhere}.ds-settings-token button{min-height:48px;min-width:48px;padding:0;border:0;background:transparent;color:#6442C5;font:600 17px/25px system-ui;cursor:pointer}.ds-settings-token button:hover,.ds-settings-token button:active{opacity:.65}.ds-settings-token button:focus-visible{outline:2px solid #6442C5}@media(prefers-color-scheme:dark){.ds-settings{background:#302A40;color:#F1EDF9}.ds-settings-muted,.ds-settings-token code{color:#B7AEC8}.ds-settings-rule{background:#463D57}.ds-settings-token button{color:#C4ACFF}}"
    },
    {
      "name": "iOS Tab Bar",
      "kind": "nav",
      "refersTo": "tab-bar",
      "description": "Color and weight signal selection; the symbol container stays transparent. SVG preview icons approximate native SF Symbols.",
      "html": "<nav class=\"ds-tabs-ios\" aria-label=\"Adder\"><button aria-current=\"page\"><span><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M8 6h13M8 12h13M8 18h13\"/><circle cx=\"3\" cy=\"6\" r=\".6\"/><circle cx=\"3\" cy=\"12\" r=\".6\"/><circle cx=\"3\" cy=\"18\" r=\".6\"/></svg></span><span>Feed</span></button><button><span><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M9 3h6l.6 3 2.7 1.6L21 7l3 5-2 2 0 3-5 3-2.6-1.3H10L7 20l-5-3v-3L0 12l3-5 2.7.6L8.4 6z\" transform=\"translate(1 1) scale(.91)\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg></span><span>Settings</span></button></nav>",
      "css": ".ds-tabs-ios{display:flex;background:#fff;border-top:1px solid #DCD8EB;padding:8px 0}.ds-tabs-ios button{flex:1;min-height:56px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:0;border:0;background:transparent;color:#686178;font:400 12px/17px system-ui;cursor:pointer}.ds-tabs-ios button>span:first-child{display:flex;align-items:center;justify-content:center;width:64px;height:30px;border-radius:15px}.ds-tabs-ios button[aria-current]{color:#6442C5;font-weight:600}.ds-tabs-ios button:focus-visible{outline:2px solid #6442C5;outline-offset:-2px}@media(prefers-color-scheme:dark){.ds-tabs-ios{background:#302A40;border-color:#463D57}.ds-tabs-ios button{color:#B7AEC8}.ds-tabs-ios button[aria-current]{color:#C4ACFF}}"
    },
    {
      "name": "Android Tab Bar",
      "kind": "nav",
      "refersTo": "tab-bar",
      "description": "Selection includes the violet capsule. SVG preview icons approximate native Material Symbols.",
      "html": "<nav class=\"ds-tabs-android\" aria-label=\"Adder\"><button aria-current=\"page\"><span><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M8 6h13M8 12h13M8 18h13\"/><circle cx=\"3\" cy=\"6\" r=\".6\"/><circle cx=\"3\" cy=\"12\" r=\".6\"/><circle cx=\"3\" cy=\"18\" r=\".6\"/></svg></span><span>Feed</span></button><button><span><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M9 3h6l.6 3 2.7 1.6L21 7l3 5-2 2 0 3-5 3-2.6-1.3H10L7 20l-5-3v-3L0 12l3-5 2.7.6L8.4 6z\" transform=\"translate(1 1) scale(.91)\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg></span><span>Settings</span></button></nav>",
      "css": ".ds-tabs-android{display:flex;background:#fff;border-top:1px solid #DCD8EB;padding:8px 0}.ds-tabs-android button{flex:1;min-height:56px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:0;border:0;background:transparent;color:#686178;font:400 12px/17px system-ui;cursor:pointer}.ds-tabs-android button>span:first-child{display:flex;align-items:center;justify-content:center;width:64px;height:30px;border-radius:15px}.ds-tabs-android button[aria-current]{color:#6442C5;font-weight:600}.ds-tabs-android button[aria-current]>span:first-child{background:#E7DFFB}.ds-tabs-android button:focus-visible{outline:2px solid #6442C5;outline-offset:-2px}@media(prefers-color-scheme:dark){.ds-tabs-android{background:#302A40;border-color:#463D57}.ds-tabs-android button{color:#B7AEC8}.ds-tabs-android button[aria-current]{color:#C4ACFF}.ds-tabs-android button[aria-current]>span:first-child{background:#3D2E59}}"
    },
    {
      "name": "Scanner Status",
      "kind": "card",
      "refersTo": "scanner-status",
      "description": "Theme-aware status card within the camera task. The camera preview and native permission flow are outside this panel sample.",
      "html": "<div class=\"ds-scanner\"><h3>Point at the code</h3><p>Your adder instance shows a QR code with its endpoint. Line it up in the frame.</p></div>",
      "css": ".ds-scanner{display:flex;flex-direction:column;gap:12px;padding:22px;border-radius:16px;background:#fff;color:#252137;font-family:system-ui}.ds-scanner h3{margin:0;font-size:22px;font-weight:700;letter-spacing:-.3px}.ds-scanner p{margin:0;color:#686178;font-size:17px;line-height:25px}@media(prefers-color-scheme:dark){.ds-scanner{background:#302A40;color:#F1EDF9}.ds-scanner p{color:#B7AEC8}}"
    }
  ],
  "narrative": {
    "northStar": "The Observation Log",
    "overview": "Adder uses cool lavender surfaces, violet actions, and amber event markers to make incoming chain events easy to read on a phone. The original snake supplies identity at the feed header and Settings footer. Chronology, compact native typography, and inspectable records provide the visual character.\n\nThe user requested an identity distinct from Ordo. Warm paper, cream and charcoal compositions, the stacked-line mark, oversized counts, and editorial presentation are confirmed anti-references. The implementation follows a code-led direction; a visual comp was never approved. Restrained mascot placement is an implementation assumption because the optional prominence question received no answer.",
    "keyCharacteristics": [
      "Cool tonal surfaces and restrained violet actions.",
      "Amber chronology markers with a visible Latest label.",
      "Original snake artwork at brand touchpoints.",
      "Native text, platform symbols, safe areas, and scalable content.",
      "Complete event data available through inline disclosure."
    ],
    "rules": [
      {
        "name": "The Action and Arrival Rule",
        "body": "Use violet for actions and amber for the latest received event; retain the accompanying text label.",
        "section": "colors"
      },
      {
        "name": "The Native Reading Rule",
        "body": "Preserve native font scaling, allow prose and data to wrap, and keep session counts at metadata scale.",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Distinguish surfaces through palette roles and fine rules; preserve the flat resting state.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the light and dark palette roles together when adding a surface.",
      "Do keep violet actions and amber latest-event markers semantically distinct.",
      "Do use the original snake at brand touchpoints and platform symbols for controls.",
      "Do preserve native text scaling, wrapping, safe areas, and the shared Reduce Motion behavior.",
      "Do expose complete event payloads through readable, selectable values.",
      "Do keep counts and timestamps subordinate to event content."
    ],
    "donts": [
      "Don't reintroduce Ordo's cream/charcoal composition, stacked-line mark, or oversized metric presentation.",
      "Don't use an Android selection capsule on the iOS tab bar.",
      "Don't label a linked endpoint healthy or live without a measured health signal.",
      "Don't treat simulator fixtures or JavaScript export as proof of physical pairing, push delivery, or Android native appearance.",
      ""
    ]
  }
}
